# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption — generate with: openssl rand -hex 32
AES_KEY=your-64-char-hex-string

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Data sources
DATA_SOURCE_MODE=stub

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Error tracking
SENTRY_DSN=https://your@sentry.io/project
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=paqar

# Email (Resend) — get key from resend.com
RESEND_API_KEY=re_your_api_key

# Cron security — generate with: openssl rand -hex 32
CRON_SECRET=your-64-char-hex-string

# Billplz — get from billplz.com dashboard
BILLPLZ_API_KEY=your-api-key
BILLPLZ_COLLECTION_ID=your-collection-id
BILLPLZ_X_SIGNATURE_KEY=your-x-signature-key

# JomCheck — accident/claim check add-on
# Flags gate SELLING the add-on (RM100 bundle / +RM88 upgrade)
JOMCHECK_ENABLED=false
NEXT_PUBLIC_JOMCHECK_ENABLED=false
# auto = API lookup at report render (needs the 4 credentials below)
# manual = owner fulfills via /admin/jomcheck; API never called
JOMCHECK_MODE=auto
JOMCHECK_API_KEY=your-api-key
JOMCHECK_USERNAME=your-username
JOMCHECK_PASSWORD=your-password
JOMCHECK_COMPANY_NAME=Paqar

# Admin page (/admin/jomcheck) — generate with: openssl rand -hex 32
ADMIN_SECRET=your-64-char-hex-string

# API Configuration
RATE_LIMIT_ENABLED=true
API_DOCS_ENABLED=true
