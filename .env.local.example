# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption — generate with: openssl rand -hex 32
AES_KEY=your-64-char-hex-string

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Data sources
DATA_SOURCE_MODE=stub

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel + Conversions API — dormant until all three are set
NEXT_PUBLIC_META_PIXEL_ID=your-pixel-id
META_PIXEL_ID=your-pixel-id
META_CAPI_TOKEN=your-capi-token

# Meta Ads operator — read-only insights + pauseCampaign, nothing else.
# System User token needs ads_management ONLY (it subsumes ads_read; Page and
# Instagram identity are validated via creative fields, so business_management
# is not required).
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
META_SYSTEM_USER_ACCESS_TOKEN=your-system-user-token
META_AD_ACCOUNT_ID=act_1234567890
META_PAGE_ID=your-page-id
META_INSTAGRAM_ACCOUNT_ID=your-ig-account-id
META_PIXEL_OR_DATASET_ID=your-pixel-or-dataset-id
META_GRAPH_API_VERSION=v25.0
# Generate with: openssl rand -hex 32
ADS_OPERATOR_CRON_SECRET=your-64-char-hex-string
# Where operator alerts and the daily report go. REQUIRED for either to be
# delivered — there is deliberately no fallback, because the old default
# (hello@paqar.my) has no MX record and silently swallowed seven reports.
ADS_ALERT_EMAIL=you@example.com

# Error tracking
SENTRY_DSN=https://your@sentry.io/project
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=paqar

# Email (Resend) — get key from resend.com
RESEND_API_KEY=re_your_api_key

# Cron security — generate with: openssl rand -hex 32
CRON_SECRET=your-64-char-hex-string

# Billplz — get from billplz.com dashboard
BILLPLZ_API_KEY=your-api-key
BILLPLZ_COLLECTION_ID=your-collection-id
BILLPLZ_X_SIGNATURE_KEY=your-x-signature-key

# JomCheck — accident/claim check add-on
# Flags gate SELLING the add-on (RM100 bundle / +RM88 upgrade)
JOMCHECK_ENABLED=false
NEXT_PUBLIC_JOMCHECK_ENABLED=false
# auto = API lookup at report render (needs the 4 credentials below)
# manual = owner fulfills via /admin/jomcheck; API never called
JOMCHECK_MODE=auto
JOMCHECK_API_KEY=your-api-key
JOMCHECK_USERNAME=your-username
JOMCHECK_PASSWORD=your-password
JOMCHECK_COMPANY_NAME=Paqar

# Admin page (/admin/jomcheck) — generate with: openssl rand -hex 32
ADMIN_SECRET=your-64-char-hex-string

# API Configuration
RATE_LIMIT_ENABLED=true
API_DOCS_ENABLED=true
