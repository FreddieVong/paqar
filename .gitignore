# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env*.local
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers
.superpowers/
supabase/.temp/
.gstack/

# Search Console service-account key.
#
# scripts/gsc-verify.mjs defaults to ~/.config/paqar/gsc-service-account.json —
# OUTSIDE the repo, deliberately: a key inside a worktree is one `git add -A`
# from being committed. These patterns are the second line of defence.
gsc-service-account*.json
*service-account*.json
